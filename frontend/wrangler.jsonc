{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker: no `main` script, Cloudflare serves ./dist directly.
  "name": "lyric-match",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
