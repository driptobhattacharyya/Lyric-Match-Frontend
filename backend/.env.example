# Copy to .env for local development. Never commit .env.

# LLM providers (both optional). Gemini is primary, OpenAI is the fallback.
# With neither key (and no stored snippets) rounds return 503 llm_unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Reasoning effort sent to OpenAI ("low" for GPT-5-family models; empty to omit).
# OPENAI_REASONING_EFFORT=low

# Supabase (optional): persistent snippet cache + leaderboard. Server-side only;
# the service-role key must never reach the frontend. Schema: supabase/schema.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required in production (Render generates it). Any long random string locally:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Comma-separated list of frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173

# 1 = deterministic placeholder lyrics, no LLM calls (frontend dev / e2e).
FAKE_LLM=0
# 1 = in-memory leaderboard, Supabase never called (local e2e).
FAKE_DB=0

# Global cap on LLM calls (Gemini + OpenAI) per UTC day; then only cached snippets.
MAX_LLM_CALLS_PER_DAY=200

# Optional pre-generated snippet cache (scripts/pregenerate.py writes it).
# SNIPPET_CACHE_PATH=data/snippets.json

# Rate limiting (per client IP). Set RATELIMIT_ENABLED=0 to disable locally.
# RATELIMIT_ENABLED=1
# RATE_LIMIT_ROUNDS=20 per minute;300 per day
# RATE_LIMIT_ACTIONS=60 per minute
# RATE_LIMIT_SCORES=6 per minute;60 per day
# RATE_LIMIT_READS=60 per minute
