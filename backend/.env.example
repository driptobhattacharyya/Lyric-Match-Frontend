# Copy to .env for local development. Never commit .env.

# Google AI Studio key. Leave empty (or set FAKE_LLM=1) to run without one.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Required in production (Render generates it). Any long random string locally:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Comma-separated list of frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173

# 1 = deterministic placeholder lyrics, no Gemini calls (frontend dev / e2e).
FAKE_LLM=0

# Global cap on Gemini calls per UTC day; after that only cached snippets are served.
MAX_LLM_CALLS_PER_DAY=200

# Optional pre-generated snippet cache (scripts/pregenerate.py writes it).
# SNIPPET_CACHE_PATH=data/snippets.json

# Rate limiting (per client IP). Set RATELIMIT_ENABLED=0 to disable locally.
# RATELIMIT_ENABLED=1
# RATE_LIMIT_ROUNDS=20 per minute;300 per day
# RATE_LIMIT_ACTIONS=60 per minute
